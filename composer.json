{
    "name": "tobento/app-language",
    "version": "2.0",
    "type": "library",
    "description": "App language support.",
    "keywords": [
        "tobento",
        "package",
        "app",
        "language"
    ],
    "homepage": "https://www.tobento.ch",
    "license": "MIT",
    "authors": [
        {
            "name": "Tobias Strub",
            "email": "info@tobento.ch",
            "homepage": "https://www.tobento.ch"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "tobento/app": "^2.0",
        "tobento/app-migration": "^2.0",
        "tobento/app-http": "^2.0",
        "tobento/app-database": "^2.0",
        "tobento/service-support": "^2.0",
        "tobento/service-dater": "^2.0",
        "tobento/service-routing": "^2.0",
        "tobento/service-requester": "^2.0",
        "tobento/service-language": "^2.0",
        "tobento/service-repository": "^2.0",
        "tobento/service-repository-storage": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.3",
        "vimeo/psalm": "^6.13",
        "nyholm/psr7": "^1.8",
        "tobento/app-translation": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Tobento\\App\\Language\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tobento\\App\\Language\\Test\\": "tests",
            "Tobento\\App\\Http\\Test\\": "vendor/tobento/app-http/tests"
        }
    },
    "scripts": {
        "test": "phpunit --testdox --colors=always",
        "psalm": "vendor/bin/psalm"
    }
}